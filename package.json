{
  "name": "swc-plugins",
  "packageManager": "pnpm@11.18.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "test": "pnpm --filter @swc/* run test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@swc/core": "^1.16.20",
    "@taplo/cli": "^0.7.0",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.toml": [
      "taplo format"
    ],
    "*.rs": [
      "cargo fmt --"
    ],
    "!(**/tests/**/*)*.js": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.ts": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.jsx": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.tsx": [
      "prettier --write"
    ]
  }
}
